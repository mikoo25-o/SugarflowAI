# Required — your real Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — enables real AI responses on the Alerts & AI page.
# Without this, /api/ask-ai still works using a deterministic
# keyword-matched fallback, clearly labeled "source": "demo-fallback".
ANTHROPIC_API_KEY=

# Optional — enables real M-Pesa Daraja calls on the Payments page.
# Without these, payments run in a clearly labeled sandbox/demo mode.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
